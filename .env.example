# Template only — NEVER put real keys in this file, it is committed to git.
# Copy to .env.local and fill in there. Without these the app serves the
# built-in sample menu from src/lib/seed-menu.ts.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — needed for admin writes in Phase 2.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /kitchen. Minimum 8 characters.
KITCHEN_PASSWORD=

# Razorpay — Phase 5. Only the key id may be exposed to the browser.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
