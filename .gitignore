# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values live in .env.local and must never be committed.
.env*
!.env.example

# OAuth client secrets downloaded from Google Cloud. Nothing reads these — the
# client id and secret are pasted into the Supabase dashboard by hand — so the
# file only ever sits here waiting to be committed by accident.
client_secret_*.json
*-credentials.json
service-account*.json

# screenshots dropped in while debugging
sc*.png

# Key exports downloaded from payment/provider dashboards. Razorpay hands you
# the secret exactly once, as a CSV, straight into your downloads folder.
rzp-*.csv
*-key*.csv
*secret*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
